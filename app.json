{
  "expo": {
    "name": "Series Sector",
    "slug": "series-sector",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07080c",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.seriessector.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "seriessector"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}